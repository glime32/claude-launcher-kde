#!/bin/bash
# Ouvre une fenêtre Konsole « Claude » avec une couleur que personne d'autre n'utilise.
# Couleurs (ordre d'attribution) : ~/.config/claude-window/couleurs  (« nom r,g,b »)
# Style (barre noire, titre et cadre en couleur) : ~/.config/claude-window/style-<nom>.qss
# Réservations : $XDG_RUNTIME_DIR/claude-couleurs/<nom> contient le pid de la fenêtre.

conf="$HOME/.config/claude-window"
dir="${XDG_RUNTIME_DIR:-/tmp}/claude-couleurs"
mkdir -p "$dir"

prise() {  # la couleur $1 est-elle utilisée par une fenêtre ouverte ?
  local pid
  pid=$(cat "$dir/$1" 2>/dev/null)
  if [ -n "$pid" ] && [ -r "/proc/$pid/cmdline" ] &&
     tr '\0' ' ' < "/proc/$pid/cmdline" | grep -qE "claude-window|claude-code-$1 "; then
    return 0
  fi
  pgrep -f -- "--desktopfile claude-code-$1 " >/dev/null  # fenêtres ouvertes avant les réservations
}

exec 9>"$dir/.verrou"
flock -w 5 9
choix="" ; rgb=""
while read -r nom couleur _; do
  case "$nom" in ""|"#"*) continue ;; esac
  if ! prise "$nom"; then choix=$nom; rgb=$couleur; break; fi
done < "$conf/couleurs"

if [ -z "$choix" ]; then
  exec 9>&-
  notify-send -a "Claude Code" -i "$HOME/.local/share/icons/claude-code.png" "Claude Code" \
    "Toutes les couleurs sont déjà prises ($(grep -c '^[^#]' "$conf/couleurs") fenêtres Claude ouvertes). Ferme-en une pour en ouvrir une autre."
  exit 1
fi
echo $$ > "$dir/$choix"   # $$ devient la fenêtre Konsole grâce à « exec » ci-dessous
exec 9>&-                 # libère le verrou (Konsole ne doit pas le garder)

export CLAUDE_FRAME_COLOR=$choix CLAUDE_FRAME_RGB=$rgb
IFS=, read -r r g b <<< "$rgb"; hex=$(printf "#%02x%02x%02x" "$r" "$g" "$b")
# réglages Konsole propres à ces fenêtres (le menu remet la valeur d'origine pour Claude)
export CLAUDE_ORIG_XDG_CONFIG_DIRS="${XDG_CONFIG_DIRS-}"
export XDG_CONFIG_DIRS="$conf/defaults:${XDG_CONFIG_DIRS:-/etc/xdg}"
exec konsole --separate -stylesheet="$conf/style-$choix.qss" --desktopfile "claude-code-$choix" \
  --hide-toolbars --show-tabbar --notransparency \
  -p ScrollBarPosition=2 -p UseCustomCursorColor=true -p "CustomCursorColor=$hex" \
  -p "LocalTabTitleFormat=%w" -p "RemoteTabTitleFormat=%w" -p DimWhenInactive=true -p DimmValue=40 \
  --workdir "$HOME" -e "$HOME/.local/bin/claude-launcher"
